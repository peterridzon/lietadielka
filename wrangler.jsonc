// Cloudflare deploys this repository directly: `wrangler deploy` uploads whatever is in
// public/ as static assets. Nothing is built or executed on their side — the page is
// generated by GitHub Actions and committed, so a deploy cannot fail on dependencies.
//
// Without this file Cloudflare regenerates a config on every build and answers its own
// setup prompts with fallbacks. Keeping it in the repository makes the deploy
// reproducible and reviewable, which is the same reason the page itself is committed.
{
  "$schema": "https://developers.cloudflare.com/schemas/wrangler.json",
  "name": "lietadielka",
  "compatibility_date": "2026-08-20",
  "assets": {
    "directory": "public"
  },
  "observability": {
    "enabled": true
  }
}
