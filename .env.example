# ---------------------------------------------------------------------------
# Database
# Leave DATABASE_URL unset to use the embedded PGlite database (no Docker needed).
# Set it to run against the PostgreSQL container from docker-compose.yml.
# ---------------------------------------------------------------------------
# DATABASE_URL=postgres://lietadielka:lietadielka@localhost:5433/lietadielka
PGLITE_PATH=./data/pglite

# ---------------------------------------------------------------------------
# Publication safety (see SECURITY.md) — flights become public only this many
# hours after the detected landing. Never set this to 0 on a public deployment.
# ---------------------------------------------------------------------------
PUBLICATION_DELAY_HOURS=6

# ---------------------------------------------------------------------------
# ADS-B collection
# ---------------------------------------------------------------------------
ADSB_PROVIDER=adsblol
ADSBLOL_HISTORY_BASE_URL=https://globe.adsb.lol
ADSBLOL_API_BASE_URL=https://api.adsb.lol
ADSB_RATE_LIMIT_RPS=2
ADSB_HTTP_TIMEOUT_MS=45000
ADSB_CACHE_DIR=./data/cache/adsb

# OpenSky requires an account; anonymous historical access was withdrawn in 2025.
# OPENSKY_CLIENT_ID=
# OPENSKY_CLIENT_SECRET=
OPENSKY_BASE_URL=https://opensky-network.org/api

# ---------------------------------------------------------------------------
# Reference data
# ---------------------------------------------------------------------------
AIRPORTS_DATA_URL=https://davidmegginson.github.io/ourairports-data/airports.csv

# ---------------------------------------------------------------------------
# Flight detection tunables (ARCHITECTURE.md §7)
# ---------------------------------------------------------------------------
DETECT_GAP_SOFT_SECONDS=1800
DETECT_GAP_HARD_SECONDS=21600
DETECT_MIN_GROUND_SECONDS=300
DETECT_MIN_FLIGHT_SECONDS=240

# ---------------------------------------------------------------------------
# Airport matching (ARCHITECTURE.md §8)
# ---------------------------------------------------------------------------
AIRPORT_SEARCH_RADIUS_KM=10
AIRPORT_MIN_CONFIDENCE=0.5

# ---------------------------------------------------------------------------
# Guard rails
# ---------------------------------------------------------------------------
ALLOW_UNVERIFIED_COST_MODELS=false
DEMO_DATA_ENABLED=false
LOG_LEVEL=info
