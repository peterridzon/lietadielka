{
  "name": "lietadielka",
  "version": "0.1.0",
  "private": true,
  "description": "Transparency platform for the use of Slovak state aircraft, built on public ADS-B data.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/db-migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "tsx src/cli/db-reset.ts",
    "seed": "tsx src/cli/seed.ts",
    "registry:sync": "tsx src/cli/registry-sync.ts",
    "airports:import": "tsx src/cli/airports-import.ts",
    "adsb:backfill": "tsx src/cli/adsb-backfill.ts",
    "flights:rebuild": "tsx src/cli/flights-rebuild.ts",
    "flights:list": "tsx src/cli/flights-list.ts",
    "missions:rebuild": "tsx src/cli/missions-rebuild.ts",
    "costs:recompute": "tsx src/cli/costs-recompute.ts",
    "costs:explain": "tsx src/cli/costs-explain.ts",
    "preview:build": "tsx preview/export.ts && python3 preview/build.py",
    "deploy:preview": "npm run preview:build && bash deploy/upload.sh",
    "deploy:cloudflare": "bash deploy/cloudflare.sh",
    "publish": "bash deploy/publish.sh",
    "purpose:set": "tsx src/cli/purpose-set.ts",
    "imports:list": "tsx src/cli/imports-list.ts",
    "obs:export": "tsx src/cli/observations-export.ts",
    "obs:import": "tsx src/cli/observations-import.ts",
    "collect:daily": "bash scripts/daily.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "archive:backfill": "tsx src/cli/archive-backfill.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.5",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.10",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.12",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
